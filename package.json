{
  "name": "clarityai",
  "version": "1.0.0",
  "private": true,
  "description": "ClarityAI - AI-powered photo enhancement desktop app",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder",
    "start": "electron .",
    "package": "npm run build:renderer && electron-builder --win zip --x64"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "electron-store": "^10.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "replicate": "^1.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.clarityai.desktop",
    "productName": "ClarityAI",
    "asar": true,
    "files": [
      "electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}_v${version}_${arch}.${ext}",
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": "zip"
    },
    "linux": {
      "target": "zip"
    }
  }
}
